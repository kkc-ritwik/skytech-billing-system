{
  "name": "skytech-billing",
  "version": "0.1.0",
  "description": "SkyTech Billing — Billing that reaches new heights. Offline GST billing & inventory for distributors serving schools/colleges.",
  "main": "./out/main/index.js",
  "author": "SkyTech",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "db:generate": "drizzle-kit generate",
    "test:calc": "esbuild scripts/test-calc.ts --bundle --platform=node --format=esm --outfile=scripts/.calc.mjs && node scripts/.calc.mjs",
    "test:qa": "esbuild scripts/qa-smoke.ts --bundle --platform=node --format=esm --alias:electron=./scripts/electron-stub.mjs --alias:@shared=./src/shared --external:@libsql/client --external:bcryptjs --outfile=scripts/.qa.mjs && node scripts/.qa.mjs",
    "test": "npm run test:calc && npm run test:qa",
    "make:icon": "electron scripts/make-icon.mjs",
    "make:docs": "electron scripts/make-docs.mjs",
    "capture": "electron scripts/capture.mjs",
    "make:brochure": "electron scripts/rasterize-bill.mjs && electron scripts/make-brochure.mjs",
    "e2e": "electron scripts/e2e.mjs",
    "portal": "node admin-portal/server.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.3.9",
    "nanoid": "^3.3.12",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^0.30.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.11",
    "zustand": "^5.0.3"
  }
}
